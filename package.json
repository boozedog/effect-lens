{
  "name": "effect-lens",
  "version": "0.0.0",
  "bin": {
    "effect-lens": "./bin/effect-lens.mjs"
  },
  "private": true,
  "type": "module",
  "devDependencies": {
    "@effect/vitest": "4.0.0-rc.109",
    "@oxlint/plugins": "^1.78.0",
    "@types/node": "^26.1.2",
    "dprint": "^0.55.2",
    "effect": "4.0.0-rc.109",
    "oxlint": "^1.78.0",
    "typescript": "^5.9.0",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "check": "tsc -b tsconfig.json",
    "typecheck": "tsc -b tsconfig.json",
    "cli": "node --experimental-strip-types src/cli/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint",
    "format": "dprint fmt",
    "format:check": "dprint check",
    "verify": "nub run pm-guard && nub run lint && nub run format:check && nub run check && nub run test && nub run dogfood && nub run policy",
    "dogfood": "node scripts/dogfood.mjs",
    "policy": "node --experimental-strip-types scripts/policy.mjs",
    "pm-guard": "node scripts/package-manager-guard.mjs",
    "release:check": "nub run verify"
  },
  "devEngines": {
    "packageManager": {
      "name": "nub",
      "version": "^0.7.5",
      "onFail": "ignore"
    }
  },
  "allowBuilds": {
    "dprint": true,
    "msgpackr-extract": true
  },
  "packageManager": "nub@0.7.5"
}
